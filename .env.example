# X (Twitter) API — OAuth 1.0a user context (required to POST tweets)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# GitHub PR flow — worker opens PRs, reviewer merges/closes them.
# Token needs `repo` scope (push branches, open/merge/close PRs, comment).
MITO_GITHUB_REPO=mitosisdev/mito
GITHUB_TOKEN=

# mito config
MITO_STATE_PATH=./mito-state.json
MITO_KILLSWITCH_PATH=./STOP
MITO_SPEND_CAP_USD=30

# Diff-size guard — a single proposed PR may not exceed these. Bounds the blast
# radius of one autonomous change. Defaults: 12 files / 600 changed lines.
MITO_MAX_PR_FILES=12
MITO_MAX_PR_LINES=600
